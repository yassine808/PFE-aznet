flowchart TD
    TRIG1["Every 15s<br/>scheduleTrigger"] --> OFF["Offset + token"]
    OFF --> GU["getUpdates"] --> XTG["Extract TG msgs"]
    TRIG2["WA Webhook GET"] --> ECHO["Echo challenge<br/>verification Meta"]
    TRIG3["WA Webhook POST"] --> COR["Correlate"] --> XWA["Extract WA msgs"]

    XTG & XWA --> CLAIM["Claim message<br/>POST /logs/claim"]
    CLAIM --> FRESH{"Fresh ?"}
    FRESH -- non --> DUP["Log duplicate"]
    FRESH -- oui --> LOOK["Lookup technicien"] --> AUTH{"Authorized ?"}

    AUTH -- non --> DENY["Log denied<br/>+ reponse de refus"]
    AUTH -- oui --> ACK["Accuse de reception"]
    ACK --> CMD{"Commande ?"}
    CMD -- "/rapport" --> LAST["Get last report"]
    CMD -- "/modifier /supprimer" --> MOD["Modify command"]
    CMD -- non --> MED{"Media ou texte ?"}

    MED -- texte --> P3["POST /process (text)"]
    MED -- media --> AI{"Audio ou image ?"}
    AI -- audio --> DL["Telecharger l audio"] --> P1["POST /process (audio)"]
    AI -- image --> P2["POST /process (image)"]

    P1 & P2 & P3 --> OUT["Process output"]
    OUT -- echec --> FAIL["Log process failed<br/>+ reponse d erreur"]
    OUT -- succes --> REPLY["Reponse du resume<br/>AU TECHNICIEN"]

    REPLY --> EXPL{"Rapport exploitable ?"}
    EXPL -- non --> STOP["Fin - aucune ecriture"]
    EXPL -- oui --> JRN["POST /journal<br/>sans retry"]
    JRN -- echec --> JFAIL["Log journal failed"]

    ERRT["Error Trigger<br/>defaillances de n8n lui-meme"] --> EROW["Format error row"] --> ELOG["POST /logs"]

    classDef hot fill:#e6f4ea,stroke:#2f855a,stroke-width:2px
    class REPLY hot
