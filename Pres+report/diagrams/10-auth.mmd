    RH -- non --> OK
    G -- require_director --> RD{"role = directeur ?"}
    RD -- non --> D3
    RD -- oui --> OK

    LOGIN["POST /auth/login"] --> TH{"8 echecs / 5 min<br/>pour cette adresse ?"}
    TH -- oui --> D4["429"]
    TH -- non --> PW{"password_hash IS NOT NULL ?"}
    PW -- non --> D5["401 - cette ligne n est pas un compte"]
    PW -- oui --> VER{"mot de passe correct ?"}
    VER -- non --> D5
    VER -- oui --> TOK["Jeton opaque en base<br/>supprimer la ligne = deconnexion"]

