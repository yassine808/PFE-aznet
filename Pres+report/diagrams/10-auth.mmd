flowchart TD
    REQ["Requete entrante"] --> H{"En-tete X-API-Key ?"}
    H -- oui --> K{"INTERNAL_API_KEY definie ?"}
    K -- non --> D1["401 - acces machine DESACTIVE<br/>jamais 'tout le monde est une machine'"]
    K -- oui --> KM{"cle correcte ?"}
    KM -- non --> D1
    KM -- oui --> MACHINE["Appelant = machine (n8n)"]

    H -- non --> C{"Cookie de session ?"}
    C -- non --> D2["401"]
    C -- oui --> S{"session en base ?"}
    S -- non --> D2
    S -- oui --> HUMAN["Appelant = humain"]

    MACHINE --> G{"Niveau exige"}
    HUMAN --> G
    G -- require_user --> OK["Autorise"]
    G -- require_human --> RH{"machine ?"}
