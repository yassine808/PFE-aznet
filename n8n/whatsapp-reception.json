{
  "name": "WhatsApp reception -> /process",
  "nodes": [
    {
      "parameters": {
        "updates": ["messages"]
      },
      "id": "e1000000-0000-4000-8000-000000000001",
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [200, 300],
      "webhookId": "whatsapp-reception",
      "credentials": {
        "whatsAppTriggerApi": {
          "id": "REPLACE_WITH_WA_OAUTH_CREDENTIAL_ID",
          "name": "WhatsApp OAuth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// WhatsApp Cloud API payload -> one item per audio message.\n// Voice notes arrive as type 'audio' (audio.voice = true); forwarded/uploaded\n// audio files are type 'audio' too -> both treated the same, like Telegram.\nconst out = [];\nfor (const item of $input.all()) {\n  // Trigger emits the change value directly (contacts + messages)\n  const v = item.json;\n  const contactName = v?.contacts?.[0]?.profile?.name;\n  for (const m of v?.messages ?? []) {\n    if (m.type === 'audio' && m.audio?.id) {\n      out.push({\n        json: {\n          media_id: m.audio.id,\n          chat_id: m.from,           // wa_id = sender phone number\n          message_id: m.id,          // wamid, used as reply context\n          user_id: m.from,\n          is_forwarded: Boolean(m.context?.forwarded),\n          technicien: contactName ?? m.from,\n        },\n      });\n    }\n  }\n}\nreturn out;"
      },
      "id": "e1000000-0000-4000-8000-000000000004",
      "name": "Extract audio msgs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "jsCode": "// Access control: allowlist of WhatsApp phone numbers (wa_id, digits only,\n// country code, no '+') with roles. Same contract as the Telegram workflows.\nconst ALLOWLIST = {\n  // '2126XXXXXXXX': { name: 'Yassine', role: 'directeur' },\n  // '2126YYYYYYYY': { name: 'Ahmed', role: 'technicien' },\n};\nconst s = $getWorkflowStaticData('global');\ns.hrRepliedTo = s.hrRepliedTo ?? {};\nconst out = [];\nfor (const item of $input.all()) {\n  const entry = ALLOWLIST[String(item.json.user_id)];\n  if (entry) {\n    out.push({ json: { ...item.json, technicien: entry.name, role: entry.role, authorized: true } });\n  } else if (!s.hrRepliedTo[item.json.chat_id]) {\n    // Outsider: exactly ONE automated HR-contact reply per chat, then silence.\n    s.hrRepliedTo[item.json.chat_id] = true;\n    out.push({ json: { ...item.json, authorized: false } });\n  }\n}\nreturn out;"
      },
      "id": "e1000000-0000-4000-8000-000000000005",
      "name": "Access control",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.authorized }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e1000000-0000-4000-8000-000000000006",
      "name": "Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [860, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "phoneNumberId": "={{ $env.WHATSAPP_PHONE_NUMBER_ID }}",
        "recipientPhoneNumber": "={{ $json.chat_id }}",
        "textBody": "Bonjour, ce service est réservé aux employés d'aznet. Pour toute demande, merci de contacter les ressources humaines : <HR_EMAIL>",
        "additionalFields": {}
      },
      "id": "e1000000-0000-4000-8000-000000000007",
      "name": "HR reply (outsider)",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [1080, 480],
      "credentials": {
        "whatsAppApi": {
          "id": "REPLACE_WITH_WA_API_CREDENTIAL_ID",
          "name": "WhatsApp API"
        }
      }
    },
    {
      "parameters": {
        "resource": "media",
        "operation": "mediaUrlGet",
        "mediaGetId": "={{ $json.media_id }}"
      },
      "id": "e1000000-0000-4000-8000-000000000008",
      "name": "Get media URL",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [1080, 180],
      "credentials": {
        "whatsAppApi": {
          "id": "REPLACE_WITH_WA_API_CREDENTIAL_ID",
          "name": "WhatsApp API"
        }
      }
    },
    {
      "parameters": {
        "resource": "media",
        "operation": "mediaUrlGetDownload",
        "mediaGetId": "={{ $('Access control').item.json.media_id }}"
      },
      "id": "e1000000-0000-4000-8000-000000000009",
      "name": "Download audio",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [1300, 180],
      "credentials": {
        "whatsAppApi": {
          "id": "REPLACE_WITH_WA_API_CREDENTIAL_ID",
          "name": "WhatsApp API"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/process",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "audio",
              "inputDataFieldName": "data"
            }
          ]
        },
        "options": {}
      },
      "id": "e1000000-0000-4000-8000-00000000000a",
      "name": "POST /process",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1520, 180]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_WITH_SPREADSHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Rapports"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "date": "={{ $now.toFormat('yyyy-MM-dd') }}",
            "heure": "={{ $now.toFormat('HH:mm') }}",
            "technicien": "={{ $('Access control').item.json.technicien }}",
            "role": "={{ $('Access control').item.json.role }}",
            "chantier": "={{ $json.report.chantier }}",
            "client": "={{ $json.report.client }}",
            "type_activite": "={{ $json.report.type_activite }}",
            "goulottes_m": "={{ $json.report.goulottes_m }}",
            "cables_m": "={{ $json.report.cables_m }}",
            "bureaux_termines": "={{ $json.report.bureaux_termines }}",
            "panneaux_raccordes": "={{ $json.report.panneaux_raccordes }}",
            "autres_travaux": "={{ $json.report.autres_travaux }}",
            "observations": "={{ $json.report.observations }}",
            "resume": "={{ $json.report.resume }}",
            "rapport_complet": "={{ $json.rapport_complet }}",
            "confidence": "={{ $json.transcription?.confidence }}",
            "flag_review": "={{ ($json.warnings ?? []).includes('low_confidence_transcription') || ($json.warnings ?? []).includes('short_transcription') }}",
            "lien_audio": "={{ $('Access control').item.json.media_id }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "e1000000-0000-4000-8000-00000000000b",
      "name": "Append Sheet row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1740, 180],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "phoneNumberId": "={{ $env.WHATSAPP_PHONE_NUMBER_ID }}",
        "recipientPhoneNumber": "={{ $('Access control').item.json.chat_id }}",
        "textBody": "=✅ Rapport enregistré\n\n{{ $('POST /process').item.json.report.resume }}{{ $('POST /process').item.json.transcription?.confidence != null ? '\\n\\n🎙️ Confiance transcription: ' + Math.round($('POST /process').item.json.transcription.confidence * 100) + '%' : '' }}{{ ($('POST /process').item.json.warnings ?? []).includes('low_confidence_transcription') ? '\\n⚠️ Confiance faible — à vérifier dans le dashboard' : '' }}",
        "additionalFields": {}
      },
      "id": "e1000000-0000-4000-8000-00000000000c",
      "name": "Reply with summary",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [1960, 180],
      "credentials": {
        "whatsAppApi": {
          "id": "REPLACE_WITH_WA_API_CREDENTIAL_ID",
          "name": "WhatsApp API"
        }
      }
    }
  ],
  "connections": {
    "WhatsApp Trigger": { "main": [[{ "node": "Extract audio msgs", "type": "main", "index": 0 }]] },
    "Extract audio msgs": { "main": [[{ "node": "Access control", "type": "main", "index": 0 }]] },
    "Access control": { "main": [[{ "node": "Authorized?", "type": "main", "index": 0 }]] },
    "Authorized?": {
      "main": [
        [{ "node": "Get media URL", "type": "main", "index": 0 }],
        [{ "node": "HR reply (outsider)", "type": "main", "index": 0 }]
      ]
    },
    "Get media URL": { "main": [[{ "node": "Download audio", "type": "main", "index": 0 }]] },
    "Download audio": { "main": [[{ "node": "POST /process", "type": "main", "index": 0 }]] },
    "POST /process": { "main": [[{ "node": "Append Sheet row", "type": "main", "index": 0 }]] },
    "Append Sheet row": { "main": [[{ "node": "Reply with summary", "type": "main", "index": 0 }]] }
  },
  "settings": { "errorWorkflow": "" },
  "active": false
}
