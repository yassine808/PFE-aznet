{
  "name": "End-of-day report -> /daily-report -> email",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "30 18 * * 1-6" }]
        }
      },
      "id": "d1000000-0000-4000-8000-000000000001",
      "name": "18:30 Mon-Sat",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_WITH_SPREADSHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Rapports"
        },
        "options": {}
      },
      "id": "d1000000-0000-4000-8000-000000000002",
      "name": "Read Rapports sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [420, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Keep only today's rows and build the /daily-report payload.\n// Emits nothing when the day had zero reports (cron ends quietly).\nconst today = $now.toFormat('yyyy-MM-dd');\nconst rows = $input.all().map(i => i.json).filter(r => r.date === today);\nif (!rows.length) return [];\nreturn [{ json: { date: today, rows } }];"
      },
      "id": "d1000000-0000-4000-8000-000000000003",
      "name": "Today's rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/daily-report",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "d1000000-0000-4000-8000-000000000004",
      "name": "POST /daily-report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 300]
    },
    {
      "parameters": {
        "sendTo": "REPLACE_WITH_MANAGER_EMAIL",
        "subject": "={{ $json.objet }}",
        "message": "={{ $json.corps.replaceAll('\\n', '<br>') }}",
        "options": {}
      },
      "id": "d1000000-0000-4000-8000-000000000005",
      "name": "Email manager",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1080, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail"
        }
      }
    }
  ],
  "connections": {
    "18:30 Mon-Sat": { "main": [[{ "node": "Read Rapports sheet", "type": "main", "index": 0 }]] },
    "Read Rapports sheet": { "main": [[{ "node": "Today's rows", "type": "main", "index": 0 }]] },
    "Today's rows": { "main": [[{ "node": "POST /daily-report", "type": "main", "index": 0 }]] },
    "POST /daily-report": { "main": [[{ "node": "Email manager", "type": "main", "index": 0 }]] }
  },
  "settings": { "errorWorkflow": "" },
  "active": false
}
