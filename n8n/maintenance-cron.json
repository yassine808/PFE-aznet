{
  "name": "Maintenance — drain Sheet retry queue + prune logs",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "d1000000-0000-4000-8000-000000000001",
      "name": "Every 5 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.API_BASE_URL }}/sheet-queue",
        "options": {
          "timeout": 10000
        }
      },
      "id": "d1000000-0000-4000-8000-000000000002",
      "name": "GET pending writes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Fan the queue out to one item per parked report so the Sheet node\n// appends them individually. Empty queue emits nothing (workflow ends).\nconst pending = $input.first().json.pending ?? [];\nreturn pending.map(p => ({ json: { queue_id: p.id, correlation_id: p.correlation_id, attempts: p.attempts, ...p.payload } }));"
      },
      "id": "d1000000-0000-4000-8000-000000000003",
      "name": "Split queue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "<GOOGLE_SHEET_ID>"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Rapports"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "date": "={{ $json.date }}",
            "heure": "={{ $json.heure }}",
            "canal": "={{ $json.canal }}",
            "technicien": "={{ $json.technicien }}",
            "role": "={{ $json.role }}",
            "chantier": "={{ $json.report.chantier }}",
            "client": "={{ $json.report.client }}",
            "type_activite": "={{ $json.report.type_activite }}",
            "goulottes_m": "={{ $json.report.goulottes_m }}",
            "cables_m": "={{ $json.report.cables_m }}",
            "bureaux_termines": "={{ $json.report.bureaux_termines }}",
            "panneaux_raccordes": "={{ $json.report.panneaux_raccordes }}",
            "autres_travaux": "={{ $json.report.autres_travaux }}",
            "observations": "={{ $json.report.observations }}",
            "resume": "={{ $json.report.resume }}",
            "rapport_complet": "={{ $json.rapport_complet }}",
            "confidence": "={{ $json.confidence }}",
            "flag_review": "={{ ($json.warnings ?? []).includes('low_confidence_transcription') || ($json.warnings ?? []).includes('short_transcription') }}",
            "lien_audio": "={{ $json.lien_audio }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {},
        "authentication": "serviceAccount"
      },
      "id": "d1000000-0000-4000-8000-000000000004",
      "name": "Retry Sheet append",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        860,
        300
      ],
      "onError": "continueErrorOutput",
      "credentials": {
        "googleApi": {
          "id": "zRwJLWyZJQXZRtsm",
          "name": "Google Service Account account"
        }
      }
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.API_BASE_URL }}/sheet-queue/{{ $('Split queue').all()[$itemIndex].json.queue_id }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ok: true}) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "d1000000-0000-4000-8000-000000000005",
      "name": "Mark resolved",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        200
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.API_BASE_URL }}/sheet-queue/{{ $('Split queue').all()[$itemIndex].json.queue_id }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ok: false, error: String($json.error?.message ?? 'retry failed')}) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "d1000000-0000-4000-8000-000000000006",
      "name": "Bump attempts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        400
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 3
            }
          ]
        }
      },
      "id": "d1000000-0000-4000-8000-000000000007",
      "name": "Daily 03:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        600
      ]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "={{ $env.API_BASE_URL }}/logs?days=30",
        "options": {
          "timeout": 30000
        }
      },
      "id": "d1000000-0000-4000-8000-000000000008",
      "name": "Prune logs (30d)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        600
      ],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Every 5 min": {
      "main": [
        [
          {
            "node": "GET pending writes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GET pending writes": {
      "main": [
        [
          {
            "node": "Split queue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split queue": {
      "main": [
        [
          {
            "node": "Retry Sheet append",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Retry Sheet append": {
      "main": [
        [
          {
            "node": "Mark resolved",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Bump attempts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Daily 03:00": {
      "main": [
        [
          {
            "node": "Prune logs (30d)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "active": false
}