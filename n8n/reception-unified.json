      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        280
      ],
      "parameters": {
        "jsCode": "// One trace id per message, threaded through every stage so the six\n// per-message log rows (and the API's own errors, logged from a\n// different process) join into one story in the dashboard.\nreturn $input.all().map(item => ({\n  json: {\n    ...item.json,\n    correlation_id: item.json.correlation_id\n      ?? `${item.json.channel}-${item.json.message_id ?? Date.now()}`,\n  },\n}));"
      }
    },
    {
      "id": "f1000000-0000-4000-8000-000000000102",
      "name": "Claim message (dedup)",
