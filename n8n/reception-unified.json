      "position": [
        1160,
        280
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_BASE_URL }}/logs/claim",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({message_id: $json.channel + ':' + ($json.message_id ?? ''), channel: $json.channel}) }}",
        "options": {
          "timeout": 5000
        }
      }
    },
    {
      "id": "f1000000-0000-4000-8000-000000000103",
      "name": "Fresh?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1280,
        280
      ],
      "parameters": {
        "conditions": {
          "options": {
