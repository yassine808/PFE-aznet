      "id": "f1000000-0000-4000-8000-000000000001",
      "name": "Every 15s",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        100,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "// Reads last processed update_id so we never re-handle old messages.\n// NOTE: static data persists only while the workflow is ACTIVE (production runs).\nconst s = $getWorkflowStaticData('global');\nconst offset = s.lastUpdateId ? s.lastUpdateId + 1 : 0;\nreturn [{ json: { offset, botToken: $env.TELEGRAM_BOT_TOKEN } }];"
      },
      "id": "f1000000-0000-4000-8000-000000000002",
      "name": "Offset + token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        140
      ]
    },
    {
      "parameters": {
        "url": "=https://api.telegram.org/bot{{ $json.botToken }}/getUpdates?offset={{ $json.offset }}&allowed_updates=[\"message\"]",
        "options": {}
      },
      "id": "f1000000-0000-4000-8000-000000000003",
      "name": "getUpdates (poll)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "// Telegram: voice note, forwarded/uploaded audio, OR typed text report.\n// Dedupe: processed message keys tracked in static data (poll restarts re-deliver).\nconst s = $getWorkflowStaticData('global');\nconst updates = $input.first().json.result ?? [];\nif (updates.length) {\n  s.lastUpdateId = Math.max(...updates.map(u => u.update_id));\n}\ns.processedMsgs = s.processedMsgs ?? {};\nconst out = [];\nfor (const u of updates) {\n  const m = u.message;\n  if (!m) continue;\n  const key = 'tg:' + m.chat.id + ':' + m.message_id;\n  if (s.processedMsgs[key]) continue;\n  const media = m.voice ?? m.audio;\n  const base = {\n    channel: 'telegram',\n    chat_id: m.chat.id,\n    message_id: m.message_id,\n    user_id: String(m.from?.id),\n    is_forwarded: Boolean(m.forward_date || m.forward_origin),\n    technicien: m.from?.first_name ?? String(m.from?.id),\n  };\n  if (media) {\n    s.processedMsgs[key] = true;\n    out.push({ json: { ...base, kind: 'audio', file_ref: media.file_id } });\n  } else if (m.text && !m.text.startsWith('/')) {\n    // typed report (ignore bot commands like /start)\n    s.processedMsgs[key] = true;\n    out.push({ json: { ...base, kind: 'text', text_input: m.text, file_ref: null } });\n  }\n}\nreturn out;"
      },
      "id": "f1000000-0000-4000-8000-000000000004",
      "name": "Extract TG msgs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        140
      ]
    },
    {
      "parameters": {
        "updates": [
          "messages"
        ]
      },
      "id": "f1000000-0000-4000-8000-000000000005",
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [
        500,
        420
      ],
      "webhookId": "whatsapp-reception-unified",
      "credentials": {
        "whatsAppTriggerApi": {
          "id": "b0ZOTKEXSgT8hyv0",
          "name": "WhatsApp OAuth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// WhatsApp: audio (voice + forwarded both type 'audio') OR typed text report.\n// Dedupe: Meta retries webhook deliveries on slow/failed responses.\nconst s = $getWorkflowStaticData('global');\ns.processedMsgs = s.processedMsgs ?? {};\nconst out = [];\nfor (const item of $input.all()) {\n  const v = item.json;\n  const contactName = v?.contacts?.[0]?.profile?.name;\n  for (const m of v?.messages ?? []) {\n    const key = 'wa:' + m.id;\n    if (s.processedMsgs[key]) continue;\n    const base = {\n      channel: 'whatsapp',\n      chat_id: m.from,\n      message_id: m.id,\n      user_id: String(m.from),\n      is_forwarded: Boolean(m.context?.forwarded),\n      technicien: contactName ?? m.from,\n    };\n    if (m.type === 'audio' && m.audio?.id) {\n      s.processedMsgs[key] = true;\n      out.push({ json: { ...base, kind: 'audio', file_ref: m.audio.id } });\n    } else if (m.type === 'text' && m.text?.body) {\n      s.processedMsgs[key] = true;\n      out.push({ json: { ...base, kind: 'text', text_input: m.text.body, file_ref: null } });\n    }\n  }\n}\nreturn out;"
      },
      "id": "f1000000-0000-4000-8000-000000000006",
      "name": "Extract WA msgs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "// Access control — ONE allowlist for both channels.\n// Keys: Telegram numeric user IDs AND WhatsApp phone numbers (digits, no '+').\nconst ALLOWLIST = {\n  '<TELEGRAM_USER_ID>': { name: 'Yassine', role: 'directeur' },           // Telegram ID\n  '<WHATSAPP_NUMBER>': { name: 'Yassine', role: 'directeur' },          // WhatsApp wa_id\n};\nconst s = $getWorkflowStaticData('global');\ns.hrRepliedTo = s.hrRepliedTo ?? {};\nconst out = [];\nfor (const item of $input.all()) {\n  const entry = ALLOWLIST[String(item.json.user_id)];\n  const dedupeKey = item.json.channel + ':' + item.json.chat_id;\n  if (entry) {\n    out.push({ json: { ...item.json, technicien: entry.name, role: entry.role, authorized: true } });\n  } else if (!s.hrRepliedTo[dedupeKey]) {\n    // Outsider: exactly ONE automated HR-contact reply per chat, then silence.\n    s.hrRepliedTo[dedupeKey] = true;\n    out.push({ json: { ...item.json, authorized: false } });\n  }\n}\nreturn out;"
      },
