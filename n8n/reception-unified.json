{
  "name": "Reception unified (Telegram + WhatsApp) -> /process",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "seconds", "secondsInterval": 15 }] }
      },
      "id": "f1000000-0000-4000-8000-000000000001",
      "name": "Every 15s",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [140, 140]
    },
    {
      "parameters": {
        "jsCode": "// Reads last processed update_id so we never re-handle old messages.\n// NOTE: static data persists only while the workflow is ACTIVE (production runs).\nconst s = $getWorkflowStaticData('global');\nconst offset = s.lastUpdateId ? s.lastUpdateId + 1 : 0;\nreturn [{ json: { offset, botToken: 'PASTE_YOUR_BOT_TOKEN_HERE' } }];"
      },
      "id": "f1000000-0000-4000-8000-000000000002",
      "name": "Offset + token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [340, 140]
    },
    {
      "parameters": {
        "url": "=https://api.telegram.org/bot{{ $json.botToken }}/getUpdates?offset={{ $json.offset }}&allowed_updates=[\"message\"]",
        "options": {}
      },
      "id": "f1000000-0000-4000-8000-000000000003",
      "name": "getUpdates (poll)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [540, 140]
    },
    {
      "parameters": {
        "jsCode": "// Telegram: voice note OR forwarded/uploaded audio -> normalized item.\nconst s = $getWorkflowStaticData('global');\nconst updates = $input.first().json.result ?? [];\nif (updates.length) {\n  s.lastUpdateId = Math.max(...updates.map(u => u.update_id));\n}\nconst out = [];\nfor (const u of updates) {\n  const m = u.message;\n  const media = m?.voice ?? m?.audio;\n  if (media) {\n    out.push({\n      json: {\n        channel: 'telegram',\n        file_ref: media.file_id,\n        chat_id: m.chat.id,\n        message_id: m.message_id,\n        user_id: String(m.from?.id),\n        is_forwarded: Boolean(m.forward_date || m.forward_origin),\n        technicien: m.from?.first_name ?? String(m.from?.id),\n      },\n    });\n  }\n}\nreturn out;"
      },
      "id": "f1000000-0000-4000-8000-000000000004",
      "name": "Extract TG msgs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [740, 140]
    },
    {
      "parameters": {
        "updates": ["messages"]
      },
      "id": "f1000000-0000-4000-8000-000000000005",
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [540, 420],
      "webhookId": "whatsapp-reception-unified",
      "credentials": {
        "whatsAppTriggerApi": {
          "id": "REPLACE_WITH_WA_OAUTH_CREDENTIAL_ID",
          "name": "WhatsApp OAuth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// WhatsApp: voice notes AND forwarded audio both arrive as type 'audio'.\nconst out = [];\nfor (const item of $input.all()) {\n  const v = item.json;\n  const contactName = v?.contacts?.[0]?.profile?.name;\n  for (const m of v?.messages ?? []) {\n    if (m.type === 'audio' && m.audio?.id) {\n      out.push({\n        json: {\n          channel: 'whatsapp',\n          file_ref: m.audio.id,\n          chat_id: m.from,\n          message_id: m.id,\n          user_id: String(m.from),\n          is_forwarded: Boolean(m.context?.forwarded),\n          technicien: contactName ?? m.from,\n        },\n      });\n    }\n  }\n}\nreturn out;"
      },
      "id": "f1000000-0000-4000-8000-000000000006",
      "name": "Extract WA msgs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [740, 420]
    },
    {
      "parameters": {
        "jsCode": "// Access control — ONE allowlist for both channels.\n// Keys: Telegram numeric user IDs AND WhatsApp phone numbers (digits, no '+').\nconst ALLOWLIST = {\n  // '123456789': { name: 'Yassine', role: 'directeur' },      // Telegram ID\n  // '2126XXXXXXXX': { name: 'Yassine', role: 'directeur' },   // WhatsApp wa_id\n};\nconst s = $getWorkflowStaticData('global');\ns.hrRepliedTo = s.hrRepliedTo ?? {};\nconst out = [];\nfor (const item of $input.all()) {\n  const entry = ALLOWLIST[String(item.json.user_id)];\n  const dedupeKey = item.json.channel + ':' + item.json.chat_id;\n  if (entry) {\n    out.push({ json: { ...item.json, technicien: entry.name, role: entry.role, authorized: true } });\n  } else if (!s.hrRepliedTo[dedupeKey]) {\n    // Outsider: exactly ONE automated HR-contact reply per chat, then silence.\n    s.hrRepliedTo[dedupeKey] = true;\n    out.push({ json: { ...item.json, authorized: false } });\n  }\n}\nreturn out;"
      },
      "id": "f1000000-0000-4000-8000-000000000007",
      "name": "Access control",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 280]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.authorized }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f1000000-0000-4000-8000-000000000008",
      "name": "Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
