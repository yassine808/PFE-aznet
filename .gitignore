# secrets
.env
*.env.local
credentials/
*.service-account.json

# python
__pycache__/
.venv/
venv/
*.pyc
.pytest_cache/
.ruff_cache/

# node
node_modules/
dist/
build/
.vercel/

# ...but Pres+report/build/ holds build *inputs*, not output: the pandoc
# reference document that carries the EMSI page setup and styles, the school
# template and the writing guide the report is checked against. The generic
# build/ rule above is meant for node output and was silently dropping all
# three, so an edit to the report's margins lived on one machine only.
!Pres+report/build/
!Pres+report/build/**

# Word's lock file for an open document
~$*.docx

# audio dataset (binary bloat — references.csv stays in git)
benchmark/dataset/audio/
# image fixtures are rendered from text_cases.json on every run, and results are
# per-run artifacts — both regenerate, neither belongs in history
benchmark/dataset/images/
# local STT experiment: ~25 GB of Hub weights and a torch+CUDA venv. The
# catalogue that reproduces them lives in download_models.py, which IS in git —
# ".venv/" above does not match ".venv-local/".
benchmark/models/
benchmark/.venv-local/

# n8n local state
.n8n/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.obsidian/

# Local mail design preview (scripts/preview_mail.py)
api/preview-mail.html

# Exported dead n8n workflows: kept locally for reference, never committed —
# they embed real credentials (a Telegram bot token leaked this way).
n8n/archive/

# Coverage output: regenerated by `pytest --cov`, consumed by the Sonar job in CI.
api/.coverage
api/coverage.xml
Dashboard/coverage/
