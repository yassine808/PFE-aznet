# ── n8n ─────────────────────────────────────────────
# Public URL webhooks are registered under (tunnel URL in dev, server URL in pilot)
WEBHOOK_URL=http://localhost:5678/

# ── WhatsApp (Meta Cloud API, test mode) ────────────
# developers.facebook.com → app → WhatsApp → API Setup
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# any string you choose; Meta echoes it during webhook verification
WHATSAPP_VERIFY_TOKEN=pfe-aznet-verify

# Meta > App > Settings > Basic > App Secret. Verifies the signature on
# every inbound WhatsApp webhook: without it anyone who finds the public
# URL can post a message claiming to be a technician's number. Left unset
# the pipeline still runs and logs that the signature is unverified.
WHATSAPP_APP_SECRET=

# ── AI providers (all free tier) ────────────────────
# console.groq.com → API Keys        (Whisper-large-v3 STT + Llama fallback)
GROQ_API_KEY=
# aistudio.google.com → Get API key  (Gemini 2.5 Flash — LLM primary + STT candidate)
GEMINI_API_KEY=
# huggingface.co → Settings → Tokens (Darija fine-tune benchmark)
HF_TOKEN=

# ── Google Sheets ───────────────────────────────────
# Service account JSON path (console.cloud.google.com → IAM → Service Accounts)
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/service-account.json
SHEET_ID=

# ── Notifications (email) ───────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIF_RECIPIENTS=chef@example.com,resp@example.com
